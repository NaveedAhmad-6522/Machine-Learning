import numpy as np

MAX_LEN = 128

def encode_source(sentence):
    ids = source_tokenizer.encode(sentence, out_type=int)
    ids = ids[:MAX_LEN]
    ids += [source_tokenizer.pad_id()] * (MAX_LEN - len(ids))
    return ids


def encode_target(sentence):
    ids = target_tokenizer.encode(sentence, out_type=int)

    ids = (
        [target_tokenizer.bos_id()]
        + ids[:MAX_LEN - 2]
        + [target_tokenizer.eos_id()]
    )

    ids += [target_tokenizer.pad_id()] * (MAX_LEN - len(ids))
    return ids


