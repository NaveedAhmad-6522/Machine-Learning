        "cell_type": "code",
        "source": [
          "import os\n",
          "import json\n",
          "import shutil\n",
          "from google.colab import files\n",
          "\n",
          "# 1. Save trained model weights\n",
          "ner_model.save_weights(\n",
          "    f\"{PROJECT_DIR}/model/ner_model.weights.h5\"\n",
          ")\n",
          "\n",
          "# 2. Save tokenizer\n",
          "tokenizer.save_pretrained(\n",
          "    f\"{PROJECT_DIR}/tokenizer\"\n",
          ")\n",
          "\n",
          "# 3. Save label mapping\n",
          "with open(\n",
          "    f\"{PROJECT_DIR}/config/label_mapping.json\",\n",
          "    \"w\"\n",
          ") as f:\n",
          "    json.dump(\n",
          "        {i: label for i, label in enumerate(label_names)},\n",
          "        f,\n",
          "        indent=4\n",
          "    )\n",
          "\n",
          "# 4. Copy current Colab notebook\n",
          "from google.colab import _message\n",
          "\n",
          "notebook = _message.blocking_request(\n",
          "    \"get_ipynb\",\n",
          "    timeout_sec=30\n",
          ")\n",
          "\n",
          "with open(\n",
          "    f\"{PROJECT_DIR}/notebooks/BERT_NER.ipynb\",\n",
          "    \"w\"\n",
          ") as f:\n",
          "    json.dump(notebook, f, indent=2)\n",
          "\n",
          "# 5. Create ZIP\n",
          "ZIP_PATH = shutil.make_archive(\n",
          "    \"/content/BERT-NER\",\n",
          "    \"zip\",\n",
          "    \"/content\",\n",
          "    \"BERT-NER\"\n",
          ")\n",
          "\n",
          "# 6. Download\n",
          "print(\"Project ZIP created:\", ZIP_PATH)\n",
          "\n",
          "files.download(ZIP_PATH)"
        ],
