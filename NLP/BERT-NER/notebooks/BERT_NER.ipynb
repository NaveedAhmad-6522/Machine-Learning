        "outputs": [],
        "source": [
          "def masked_loss(labels, logits):\n",
          "\n",
          "    # Identify valid labels\n",
          "    mask = tf.not_equal(labels, -100)\n",
          "\n",
          "    # Replace -100 with a valid class ID temporarily\n",
          "    safe_labels = tf.where(\n",
          "        mask,\n",
          "        labels,\n",
          "        tf.zeros_like(labels)\n",
          "    )\n",
          "\n",
          "    # Calculate individual losses\n",
          "    losses = loss_fn(safe_labels, logits)\n",
          "\n",
          "    # Convert mask to float\n",
          "    mask = tf.cast(mask, dtype=losses.dtype)\n",
          "\n",
          "    # Ignore invalid positions\n",
          "    losses = losses * mask\n",
          "\n",
          "    # Average over valid tokens only\n",
          "    return tf.reduce_sum(losses) / tf.reduce_sum(mask)"
        ]
      },
      {
        "cell_type": "code",
        "execution_count": 45,
        "metadata": {
          "id": "QIHYh2AvY5Zc",
          "executionInfo": {
            "status": "ok",
            "timestamp": 1794163201965,
            "user_tz": -300,
            "elapsed": 37,
            "user": {
              "displayName": "naveed ahmad",
              "userId": "09380320585567295783"
            }
          }
        },
        "outputs": [],
        "source": [
          "optimizer = tf_keras.optimizers.Adam(\n",
          "    learning_rate=2e-5\n",
          ")"
        ]
