        "source": [
          "loss_fn = tf_keras.losses.SparseCategoricalCrossentropy(\n",
          "    from_logits=True,\n",
          "    reduction=\"none\"\n",
          ")"
        ]
      },
      {
        "cell_type": "code",
        "execution_count": 44,
        "metadata": {
          "id": "6B_sPqJ0YnXQ",
          "executionInfo": {
